@page "/relatorios"
@inject HttpClient Http
@inject IConfiguration Config
@inject IJSRuntime JS
@using System.Net.Http.Json
@using System.Text.Json
@using OficinaWeb.Models

<PageTitle>Estatísticas Avançadas - FREITAS AUTOCENTER</PageTitle>

<div class="container-fluid py-4 px-lg-5">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-5 gap-3">
        <div>
            <h1 class="fw-bold mb-1" style="color: #ff6600; letter-spacing: -1px;">DASHBOARD EXECUTIVO <span class="text-white-50 fw-light">@selectedYear</span></h1>
            <p class="text-white-50 mb-0">Performance por Ciclo de Trabalho (Competência)</p>
        </div>
        <div class="d-flex gap-3 align-items-center">
            <div class="input-group shadow-sm">
                <span class="input-group-text bg-dark border-secondary text-white-50"><i class="bi bi-calendar3"></i></span>
                <select class="form-select bg-dark text-white border-secondary fw-bold" @onchange="OnMonthChanged" style="min-width: 150px;">
                    @for (int i = 1; i <= 12; i++)
                    {
                        <option value="@i" selected="@(i == selectedMonth)">@System.Globalization.DateTimeFormatInfo.CurrentInfo.GetMonthName(i).ToUpper()</option>
                    }
                </select>
            </div>
            <a href="/" class="btn btn-outline-secondary px-4 fw-bold">SAIR</a>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="d-flex flex-column align-items-center py-5">
            <div class="spinner-grow text-warning" role="status"></div>
            <span class="text-white-50 mt-3 text-uppercase small ls-2">Sincronizando cronologia financeira...</span>
        </div>
    }
    else
    {
        <div class="row g-4 mb-5 row-cols-1 row-cols-md-2 row-cols-xl-5">
            <div class="col">
                <div class="card h-100 border-0 shadow-sm" style="background: #111; border-bottom: 3px solid #198754 !important;">
                    <div class="card-body p-3">
                        <h6 class="text-white-50 text-uppercase x-small mb-2">Receita do Ciclo</h6>
                        <h4 class="text-white fw-bold mb-1 text-nowrap">R$ @faturamentoMensal.ToString("N2")</h4>
                        <small class="text-success"><i class="bi bi-graph-up me-1"></i>Total apurado</small>
                    </div>
                </div>
            </div>
            
            <div class="col">
                <div class="card h-100 border-0 shadow-sm" style="background: #111; border-bottom: 3px solid #0d6efd !important;">
                    <div class="card-body p-3">
                        <h6 class="text-white-50 text-uppercase x-small mb-2">Volume de Fluxo</h6>
                        <h4 class="text-white fw-bold mb-1 text-nowrap">@carrosResolvidos</h4>
                        <small class="text-primary"><i class="bi bi-check2-circle me-1"></i>O.S. Finalizadas</small>
                    </div>
                </div>
            </div>
            
            <div class="col">
                <div class="card h-100 border-0 shadow-sm card-clickable" @onclick="() => showProductModal = true" style="background: #111; border-bottom: 3px solid #ffc107 !important; cursor: pointer;">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h6 class="text-white-50 text-uppercase x-small mb-3">Total Saídas (Estoque)</h6>
                                <h4 class="text-white fw-bold mb-1 text-nowrap">R$ @totalSaidasEstoque.ToString("N2")</h4>
                            </div>
                            <i class="bi bi-search text-warning opacity-50"></i>
                        </div>
                        <small class="text-warning"><i class="bi bi-box-seam me-1"></i>Produtos com código</small>
                    </div>
                </div>
            </div>

            <div class="col">
                <div class="card h-100 border-0 shadow-sm card-clickable" @onclick="OpenAvulsosModal" style="background: #111; border-bottom: 3px solid #dc3545 !important; cursor: pointer;">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h6 class="text-white-50 text-uppercase x-small mb-3">Lucro Avulsos</h6>
                                <h4 class="text-white fw-bold mb-1 text-nowrap">R$ @lucroAvulsoTotal.ToString("N2")</h4>
                            </div>
                            <i class="bi bi-search text-danger opacity-50"></i>
                        </div>
                        <small class="text-danger"><i class="bi bi-bag-plus me-1"></i>Painel de Repasse</small>
                    </div>
                </div>
            </div>

            <div class="col">
                <div class="card h-100 border-0 shadow-sm" style="background: #111; border-bottom: 3px solid #6c757d !important;">
                    <div class="card-body p-3">
                        <h6 class="text-white-50 text-uppercase x-small mb-2">Conversão PIX</h6>
                        <h4 class="text-white fw-bold mb-1 text-nowrap">R$ @totalPix.ToString("N2")</h4>
                        <small class="text-secondary"><i class="bi bi-lightning-charge me-1"></i>Recebimento instantâneo</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4 mb-5">
            <div class="col-lg-8">
                <div class="card border-0 p-4 shadow-lg h-100" style="background: #0d0d0d; border: 1px solid #222 !important;">
                    <div class="d-flex justify-content-between align-items-center mb-5">
                        <h5 class="text-white mb-0 text-uppercase small fw-bold">Faturamento por Sequência Cronológica</h5>
                        <i class="bi bi-info-circle text-white-50" title="Ordenado pela data real de conclusão dentro deste ciclo"></i>
                    </div>
                    <div class="d-flex align-items-end gap-1 pb-2" style="height: 220px; border-bottom: 1px solid #333; overflow-x: auto;">
                        @if (faturamentoDiario.Any())
                        {
                            @foreach (var ponto in faturamentoDiario)
                            {
                                <div class="flex-grow-1 text-center group-bar" style="min-width: 35px;">
                                    <div class="chart-bar"
                                         style="height: @(CalcularAltura(ponto.Valor))px;"
                                         title="Data @ponto.DataRotulo: R$ @ponto.Valor.ToString("N2")">
                                    </div>
                                    <small class="text-white-50 d-block mt-2" style="font-size: 0.6rem; white-space: nowrap;">@ponto.DataRotulo</small>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="w-100 text-center text-white-50 mb-5 py-5">Nenhum lançamento registrado para este período.</div>
                        }
                    </div>
                    <div class="d-flex justify-content-between mt-3 px-1 text-white-50 x-small fw-bold">
                        <span>INÍCIO (@(faturamentoDiario.FirstOrDefault()?.DataRotulo ?? "--/--"))</span>
                        <span class="text-warning">ORDEM DE LANÇAMENTO</span>
                        <span>FIM (@(faturamentoDiario.LastOrDefault()?.DataRotulo ?? "--/--"))</span>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="card border-0 p-4 shadow-lg h-100" style="background: #0d0d0d; border: 1px solid #222 !important;">
                    <h5 class="text-white mb-4 text-uppercase small fw-bold">Divisão por Meio</h5>
                    <div class="mt-2">
                        <div class="mb-4">
                            <div class="d-flex justify-content-between text-white-50 mb-1 small"><span>Cartão de Crédito</span><span>@((faturamentoMensal > 0 ? (totalCredito / faturamentoMensal) : 0).ToString("P0"))</span></div>
                            <div class="progress" style="height: 8px; background: #222;"><div class="progress-bar bg-primary" style="width: @((faturamentoMensal > 0 ? (totalCredito / faturamentoMensal) * 100 : 0).ToString("0"))%"></div></div>
                        </div>
                        <div class="mb-4">
                            <div class="d-flex justify-content-between text-white-50 mb-1 small"><span>Dinheiro Vivo</span><span>@((faturamentoMensal > 0 ? (totalDinheiro / faturamentoMensal) : 0).ToString("P0"))</span></div>
                            <div class="progress" style="height: 8px; background: #222;"><div class="progress-bar bg-success" style="width: @((faturamentoMensal > 0 ? (totalDinheiro / faturamentoMensal) * 100 : 0).ToString("0"))%"></div></div>
                        </div>
                        <div>
                            <div class="d-flex justify-content-between text-white-50 mb-1 small"><span>PIX / Outros</span><span>@((faturamentoMensal > 0 ? (totalPix / faturamentoMensal) : 0).ToString("P0"))</span></div>
                            <div class="progress" style="height: 8px; background: #222;"><div class="progress-bar bg-info" style="width: @((faturamentoMensal > 0 ? (totalPix / faturamentoMensal) * 100 : 0).ToString("0"))%"></div></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 p-4 shadow-lg mb-5" style="background: #0d0d0d; border: 1px solid #222 !important;">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h5 class="text-white mb-0 text-uppercase small fw-bold">Histórico Geral do Ciclo</h5>
                <span class="badge bg-dark border border-secondary text-white-50 px-3 py-2">@ordensNoMes.Count Registros</span>
            </div>
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle mb-0">
                    <thead class="text-white-50 text-uppercase x-small border-secondary">
                        <tr>
                            <th class="py-3">Status</th>
                            <th class="py-3">Data Real</th>
                            <th class="py-3">Proprietário / Cliente</th>
                            <th class="py-3">Veículo</th>
                            <th class="py-3 text-end">Investimento Total</th>
                        </tr>
                    </thead>
                    <tbody class="border-0">
                        @foreach (var os in ordensNoMes)
                        {
                            <tr class="border-secondary">
                                <td><span class="badge rounded-pill bg-success-subtle text-success border border-success" style="font-size: 0.65rem;">CONCLUÍDO</span></td>
                                <td class="small">@(os.CompletionDate?.ToString("dd/MM/yyyy HH:mm") ?? "--")</td>
                                <td class="fw-bold">@(os.Vehicle?.CustomerName ?? "Consumidor")</td>
                                <td class="text-white-50">@(os.Vehicle?.Model ?? "Geral")</td>
                                <td class="text-end fw-bold">R$ @os.TotalAmount.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@if (showProductModal)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.8); backdrop-filter: blur(4px);" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content bg-dark text-white border-secondary shadow-lg">
                <div class="modal-header border-secondary p-4">
                    <h5 class="modal-title fw-bold text-warning d-flex align-items-center">
                        <i class="bi bi-box-seam me-2"></i> DETALHAMENTO DE SAÍDAS DE ESTOQUE
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => showProductModal = false"></button>
                </div>
                <div class="modal-body p-0">
                    <div class="table-responsive" style="max-height: 500px;">
                        <table class="table table-dark table-hover mb-0">
                            <thead class="sticky-top bg-dark text-white-50 x-small text-uppercase border-secondary">
                                <tr>
                                    <th class="p-3">O.S.</th>
                                    <th class="p-3">Data</th>
                                    <th class="p-3">Produto</th>
                                    <th class="p-3">Cliente</th>
                                    <th class="p-3 text-center">Qtd</th>
                                    <th class="p-3 text-end">Valor Saída</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (produtosSaidaList.Any())
                                {
                                    @foreach (var item in produtosSaidaList.OrderByDescending(i => i.Data))
                                    {
                                        <tr class="border-secondary">
                                            <td class="p-3 text-warning fw-bold">#@item.OsId</td>
                                            <td class="p-3 small text-white-50">@item.Data.ToString("dd/MM/yy")</td>
                                            <td class="p-3 fw-bold">@item.Descricao</td>
                                            <td class="p-3 small">@item.Cliente</td>
                                            <td class="p-3 text-center"><span class="badge bg-secondary">@item.Quantidade</span></td>
                                            <td class="p-3 text-end fw-bold text-warning">R$ @item.ValorTotal.ToString("N2")</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" class="text-center py-5 text-white-50">Nenhum produto com código registrado neste ciclo.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer border-secondary p-3 bg-black">
                    <div class="w-100 d-flex justify-content-between align-items-center">
                        <span class="text-white-50 small">Total acumulado em peças:</span>
                        <h4 class="text-warning fw-bold mb-0 text-nowrap">R$ @totalSaidasEstoque.ToString("N2")</h4>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@if (showAvulsoModal)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.8); backdrop-filter: blur(4px);" tabindex="-1">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content bg-dark text-white border-secondary shadow-lg">
                <div class="modal-header border-secondary p-4">
                    <h5 class="modal-title fw-bold text-danger d-flex align-items-center">
                        <i class="bi bi-bag-plus me-2"></i> GESTÃO DE LUCRO AVULSO (CICLO DE REPASSE)
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => showAvulsoModal = false"></button>
                </div>
                <div class="modal-body p-4 bg-black">
                    @if (isLoadingCycle)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border text-danger"></div>
                            <div class="text-white-50 mt-2 small">Calculando fluxo do ciclo...</div>
                        </div>
                    }
                    else
                    {
                        <div class="row g-3 mb-4">
                            <div class="col-md-4">
                                <div class="p-3 border border-secondary rounded shadow-sm" style="background-color: #111; border-left: 4px solid #ffc107 !important;">
                                    <small class="text-white-50 d-block text-uppercase fw-bold mb-1">Lucro Acumulado (Ciclo)</small>
                                    <h3 class="text-warning fw-bold mb-0">R$ @lucroCicloAtual.ToString("N2")</h3>
                                    <small class="text-muted" style="font-size: 0.7rem;"><i class="bi bi-clock me-1"></i>Desde @lastClosingDate.ToString("dd/MM/yyyy HH:mm")</small>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="p-3 border border-secondary rounded shadow-sm" style="background-color: #111; border-left: 4px solid #0dcaf0 !important;">
                                    <small class="text-white-50 d-block text-uppercase fw-bold mb-1">Lucro via PIX / Transf.</small>
                                    <h3 class="text-info fw-bold mb-0">R$ @lucroCicloPix.ToString("N2")</h3>
                                    <small class="text-muted" style="font-size: 0.7rem;">Valor proporcional recebido</small>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="p-3 border border-secondary rounded shadow-sm" style="background-color: #111; border-left: 4px solid #198754 !important;">
                                    <small class="text-white-50 d-block text-uppercase fw-bold mb-1">Lucro em Dinheiro</small>
                                    <h3 class="text-success fw-bold mb-0">R$ @lucroCicloDinheiro.ToString("N2")</h3>
                                    <small class="text-muted" style="font-size: 0.7rem;">Valor proporcional recebido</small>
                                </div>
                            </div>
                            <div class="col-12 mt-3">
                                <button class="btn btn-outline-danger fw-bold w-100 py-2 shadow-sm" @onclick="FecharCiclo" disabled="@(lucroCicloAtual <= 0)">
                                    <i class="bi bi-arrow-repeat me-2"></i>FECHAR CICLO E ZERAR CONTAGEM PARA A PRÓXIMA SEMANA
                                </button>
                            </div>
                        </div>

                        <h6 class="text-white-50 text-uppercase fw-bold mb-3 border-bottom border-secondary pb-2">
                            <i class="bi bi-list-ul me-2"></i>Detalhamento das Vendas Avulsas (Ciclo Atual)
                        </h6>
                        <div class="table-responsive" style="max-height: 350px;">
                            <table class="table table-dark table-hover mb-0 align-middle">
                                <thead class="sticky-top bg-dark text-white-50 x-small text-uppercase border-secondary">
                                    <tr>
                                        <th class="p-3">O.S.</th>
                                        <th class="p-3">Data</th>
                                        <th class="p-3">Item Avulso</th>
                                        <th class="p-3 text-center">Pgto</th>
                                        <th class="p-3 text-end">Custo</th>
                                        <th class="p-3 text-end">Venda</th>
                                        <th class="p-3 text-end text-success">Lucro</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (avulsosCiclo.Any())
                                    {
                                        @foreach (var item in avulsosCiclo.OrderByDescending(i => i.Data))
                                        {
                                            <tr class="border-secondary">
                                                <td class="p-3 text-warning fw-bold">#@item.OsId</td>
                                                <td class="p-3 small text-white-50">@item.Data.ToString("dd/MM/yy HH:mm")</td>
                                                <td class="p-3 fw-bold">@item.Descricao<br><small class="text-muted fw-normal">@item.Cliente</small></td>
                                                <td class="p-3 text-center"><span class="badge bg-secondary">@item.MetodoPagamento</span></td>
                                                <td class="p-3 text-end text-warning">R$ @item.ValorCusto.ToString("N2")</td>
                                                <td class="p-3 text-end text-info">R$ @item.ValorVenda.ToString("N2")</td>
                                                <td class="p-3 text-end text-success fw-bold">R$ @item.Lucro.ToString("N2")</td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="7" class="text-center py-5 text-white-50">Nenhum lucro avulso registrado desde o último fechamento.</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool isLoading = true, showProductModal = false, showAvulsoModal = false, isLoadingCycle = false;
    private int selectedMonth, selectedYear, carrosResolvidos;
    private decimal faturamentoMensal, totalPix, totalCredito, totalDinheiro, totalSaidasEstoque;
    private decimal lucroAvulsoTotal;
    
    private DateTime lastClosingDate;
    private List<AvulsoExit> avulsosCiclo = new();
    private decimal lucroCicloAtual, lucroCicloPix, lucroCicloDinheiro;

    private List<PontoGrafico> faturamentoDiario = new();
    private List<ServiceOrderDTO> ordensNoMes = new();
    private List<ProductExit> produtosSaidaList = new();
    private List<LaborServiceDTO>? catalogoServicos;

    private string ApiUrl = "";

    protected override async Task OnInitializedAsync()
    {
        ApiUrl = Config["ApiBaseUrl"] ?? "https://localhost:7082";
        await InitialLoad();
    }

    private async Task InitialLoad()
    {
        try
        {
            var settings = await Http.GetFromJsonAsync<SystemSettingsDTO>($"{ApiUrl}/api/settings");
            selectedMonth = settings?.ActiveMonth ?? DateTime.Now.Month;
            selectedYear = settings?.ActiveYear ?? DateTime.Now.Year;
            lastClosingDate = settings?.LastClosingDate ?? DateTime.MinValue;
        }
        catch
        {
            selectedMonth = DateTime.Now.Month;
            selectedYear = DateTime.Now.Year;
        }
        await LoadData();
    }

    private async Task OnMonthChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int m)) { selectedMonth = m; await LoadData(); }
    }

    private async Task LoadData()
    {
        try
        {
            isLoading = true;
            catalogoServicos = await Http.GetFromJsonAsync<List<LaborServiceDTO>>($"{ApiUrl}/api/laborservices") ?? new();
            var osList = await Http.GetFromJsonAsync<List<ServiceOrderDTO>>($"{ApiUrl}/api/serviceorders/periodo?mes={selectedMonth}&ano={selectedYear}") ?? new();
            
            faturamentoMensal = 0; totalPix = 0; totalCredito = 0; totalDinheiro = 0; totalSaidasEstoque = 0; lucroAvulsoTotal = 0;
            ordensNoMes.Clear(); produtosSaidaList.Clear();

            var filtradas = osList.Where(x => x.Status == "Completed").ToList();
            carrosResolvidos = filtradas.Count;

            foreach (var os in filtradas)
            {
                decimal valor = os.AmountPaid;
                string metodo = (os.PaymentMethod ?? "").ToUpper();
                DateTime dataConclusao = os.CompletionDate ?? DateTime.Now;

                faturamentoMensal += valor;
                if (metodo == "PIX") totalPix += valor;
                else if (metodo.Contains("CREDITO") || metodo.Contains("CRÉDITO")) totalCredito += valor;
                else if (metodo == "DINHEIRO") totalDinheiro += valor;

                if (os.Items != null)
                {
                    foreach (var item in os.Items)
                    {
                        if (item.ProductId != null)
                        {
                            totalSaidasEstoque += item.Price;
                            produtosSaidaList.Add(new ProductExit
                            {
                                OsId = os.Id,
                                Data = dataConclusao,
                                Descricao = item.Description,
                                Cliente = os.Vehicle?.CustomerName ?? "Consumidor",
                                Quantidade = item.Quantity,
                                ValorTotal = item.Price
                            });
                        }

                        bool existeNoCatalogo = catalogoServicos.Any(c => string.Equals(c.Name, item.Description, StringComparison.OrdinalIgnoreCase));
                        bool isServico = item.ItemType == "Service" || (item.ProductId == null && existeNoCatalogo);
                        bool isAvulso = !isServico && item.ProductId == null;

                        if (isAvulso && item.CostPrice > 0)
                        {
                            lucroAvulsoTotal += (item.Price - item.CostPrice);
                        }
                    }
                }
                ordensNoMes.Add(os);
            }

            faturamentoDiario = ordensNoMes
                .GroupBy(o => (o.CompletionDate ?? DateTime.Now).Date)
                .Select(g => new PontoGrafico
                {
                    DataOriginal = g.Key,
                    DataRotulo = g.Key.ToString("dd/MM"),
                    Valor = g.Sum(o => o.AmountPaid)
                })
                .OrderBy(p => p.DataOriginal).ToList();
        }
        catch (Exception ex) { Console.WriteLine($"Erro: {ex.Message}"); }
        finally { isLoading = false; StateHasChanged(); }
    }

    private async Task OpenAvulsosModal()
    {
        showAvulsoModal = true;
        await LoadCycleData();
    }

    private async Task LoadCycleData()
    {
        isLoadingCycle = true;
        StateHasChanged();
        try
        {
            var settings = await Http.GetFromJsonAsync<SystemSettingsDTO>($"{ApiUrl}/api/settings");
            lastClosingDate = settings?.LastClosingDate ?? DateTime.MinValue;

            var recentOrders = await Http.GetFromJsonAsync<List<ServiceOrderDTO>>($"{ApiUrl}/api/serviceorders/completed?take=150") ?? new();
            var cycleOrders = recentOrders.Where(o => (o.CompletionDate ?? DateTime.Now) >= lastClosingDate).ToList();

            avulsosCiclo.Clear(); lucroCicloAtual = 0; lucroCicloPix = 0; lucroCicloDinheiro = 0;

            foreach (var os in cycleOrders)
            {
                if (os.Items != null)
                {
                    foreach (var item in os.Items)
                    {
                        bool existeNoCatalogo = catalogoServicos != null && catalogoServicos.Any(c => string.Equals(c.Name, item.Description, StringComparison.OrdinalIgnoreCase));
                        bool isServico = item.ItemType == "Service" || (item.ProductId == null && existeNoCatalogo);
                        bool isAvulso = !isServico && item.ProductId == null;

                        if (isAvulso && item.CostPrice > 0)
                        {
                            decimal lucroItem = item.Price - item.CostPrice;
                            lucroCicloAtual += lucroItem;

                            if (os.Payments != null && os.Payments.Any())
                            {
                                foreach (var p in os.Payments)
                                {
                                    decimal prop = os.TotalAmount > 0 ? (p.Amount / os.TotalAmount) : 0;
                                    string m = (p.PaymentMethod ?? "").ToUpper();
                                    if (m == "PIX") lucroCicloPix += (lucroItem * prop);
                                    else if (m.Contains("DINHEIRO")) lucroCicloDinheiro += (lucroItem * prop);
                                }
                            }
                            else
                            {
                                string m = (os.PaymentMethod ?? "").ToUpper();
                                if (m == "PIX") lucroCicloPix += lucroItem;
                                else if (m.Contains("DINHEIRO")) lucroCicloDinheiro += lucroItem;
                            }

                            string metodosStr = os.Payments != null && os.Payments.Any()
                                ? string.Join(" / ", os.Payments.Select(p => p.PaymentMethod))
                                : (os.PaymentMethod ?? "N/A");

                            avulsosCiclo.Add(new AvulsoExit
                            {
                                OsId = os.Id,
                                Data = os.CompletionDate ?? DateTime.Now,
                                Descricao = item.Description,
                                Cliente = os.Vehicle?.CustomerName ?? "Consumidor",
                                ValorVenda = item.Price,
                                ValorCusto = item.CostPrice,
                                MetodoPagamento = metodosStr
                            });
                        }
                    }
                }
            }
        }
        catch (Exception ex) { Console.WriteLine("Erro ao carregar ciclo avulsos: " + ex.Message); }
        finally { isLoadingCycle = false; StateHasChanged(); }
    }

    private async Task FecharCiclo()
    {
        bool confirm = await JS.InvokeAsync<bool>("confirm", "Deseja fechar o ciclo atual? O lucro acumulado será zerado e uma nova contagem iniciará a partir de agora.");
        if (confirm)
        {
            await Http.PostAsync($"{ApiUrl}/api/settings/close-cycle", null);
            await LoadCycleData();
            await LoadData();
        }
    }

    private int CalcularAltura(decimal valor)
    {
        var max = faturamentoDiario.Any() ? faturamentoDiario.Max(d => d.Valor) : 0;
        return max == 0 ? 0 : (int)((valor / max) * 180);
    }

    public class ProductExit { public int OsId { get; set; } public DateTime Data { get; set; } public string Descricao { get; set; } = ""; public string Cliente { get; set; } = ""; public int Quantidade { get; set; } public decimal ValorTotal { get; set; } }
    public class AvulsoExit { public int OsId { get; set; } public DateTime Data { get; set; } public string Descricao { get; set; } = ""; public string Cliente { get; set; } = ""; public decimal ValorVenda { get; set; } public decimal ValorCusto { get; set; } public decimal Lucro => ValorVenda - ValorCusto; public string MetodoPagamento { get; set; } = ""; }
    public class PontoGrafico { public DateTime DataOriginal { get; set; } public string DataRotulo { get; set; } = ""; public decimal Valor { get; set; } }
}